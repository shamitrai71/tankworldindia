{
  "hosting": {
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**",
               "**/companies*.json", "**/*.xlsx", "**/*.csv", "**/*.pkl", "**/*.md", "**/*.py", "**/*.zip", "**/*.pdf", "**/*.docx"],
    "headers": [
      { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "public, max-age=300" } ] },
      { "source": "/",           "headers": [ { "key": "Cache-Control", "value": "public, max-age=300" } ] }
    ]
  }
}
